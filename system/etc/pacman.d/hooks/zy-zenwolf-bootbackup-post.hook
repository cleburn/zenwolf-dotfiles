[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = boot/*-ucode.img
Target = usr/lib/systemd/boot/efi/*

[Action]
Depends = rsync
Description = Capturing post-transaction ESP state inside Btrfs root...
When = PostTransaction
Exec = /usr/bin/rsync -a --delete --omit-dir-times --exclude=/loader/random-seed /boot/ /.bootbackup/
