#!/usr/bin/env bash

set -euo pipefail

readonly service='zenwolf-hyprlock.service'

# The user service gives the post-suspend system hook one precise process to
# restart. Starting an already-active unit is intentionally a harmless no-op.
if ! systemctl --user start "$service"; then
    printf 'ERROR: the Zenwolf lock screen did not start.\n' >&2
    printf 'Inspect with: systemctl --user status %s\n' "$service" >&2
    exit 1
fi
