# Generated by zenwolf-theme-build. Edit profile.json, not this file.
general {
    hide_cursor = true
    ignore_empty_input = true
    immediate_render = true
}

animations {
    enabled = false
}

background {
    monitor =
    path = @WALLPAPER@
    color = rgb(@HYPRLOCK_BACKGROUND@)
    blur_passes = 0
    brightness = @HYPRLOCK_BACKGROUND_BRIGHTNESS@
}

shape {
    monitor =
    size = @HYPRLOCK_PANEL_WIDTH@, @HYPRLOCK_PANEL_HEIGHT@
    color = @HYPRLOCK_PANEL@
    rounding = @HYPRLOCK_PANEL_RADIUS@
    border_size = 1
    border_color = @HYPRLOCK_PANEL_BORDER@
    position = @HYPRLOCK_PANEL_X@, @HYPRLOCK_PANEL_Y@
    halign = center
    valign = center
    zindex = 0
}

label {
    monitor =
    text = $TIME
    color = rgb(@HYPRLOCK_FOREGROUND@)
    font_size = @HYPRLOCK_TIME_SIZE@
    font_family = JetBrainsMono Nerd Font
    position = @HYPRLOCK_TIME_X@, @HYPRLOCK_TIME_Y@
    halign = center
    valign = center
    zindex = 1
}

label {
    monitor =
    text = Zenwolf · $USER
    color = rgb(@HYPRLOCK_MUTED@)
    font_size = @HYPRLOCK_IDENTITY_SIZE@
    font_family = JetBrainsMono Nerd Font
    position = @HYPRLOCK_IDENTITY_X@, @HYPRLOCK_IDENTITY_Y@
    halign = center
    valign = center
    zindex = 1
}

input-field {
    monitor =
    size = @HYPRLOCK_INPUT_WIDTH@, @HYPRLOCK_INPUT_HEIGHT@
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.20
    dots_center = true
    outer_color = rgb(@HYPRLOCK_ACCENT@)
    inner_color = @HYPRLOCK_INPUT@
    font_color = rgb(@HYPRLOCK_FOREGROUND@)
    font_family = JetBrainsMono Nerd Font
    fade_on_empty = false
    placeholder_text = <i>Enter password to unlock</i>
    check_color = rgb(@HYPRLOCK_GREEN@)
    fail_color = rgb(@HYPRLOCK_RED@)
    fail_text = <i>$FAIL ($ATTEMPTS)</i>
    capslock_color = rgb(@HYPRLOCK_GOLD@)
    rounding = @HYPRLOCK_INPUT_RADIUS@
    position = @HYPRLOCK_INPUT_X@, @HYPRLOCK_INPUT_Y@
    halign = center
    valign = center
    zindex = 1
}
