/* Generated by zenwolf-theme-build. Edit profile.json or this template. */
@import url("@GTK_THEME_IMPORT@");

@define-color theme_bg_color @BACKGROUND@;
@define-color theme_fg_color @FOREGROUND@;
@define-color theme_base_color @ROFI_SURFACE_COLOR@;
@define-color theme_text_color @FOREGROUND@;
@define-color theme_selected_bg_color @ACCENT@;
@define-color theme_selected_fg_color @SELECTION_TEXT@;
@define-color insensitive_bg_color @ROFI_SURFACE_COLOR@;
@define-color insensitive_fg_color @MUTED@;
@define-color insensitive_base_color @BACKGROUND@;
@define-color theme_unfocused_bg_color @BACKGROUND@;
@define-color theme_unfocused_fg_color @MUTED@;
@define-color theme_unfocused_base_color @ROFI_SURFACE_COLOR@;
@define-color theme_unfocused_text_color @MUTED@;
@define-color theme_unfocused_selected_bg_color @ROFI_SURFACE_HOVER_COLOR@;
@define-color theme_unfocused_selected_fg_color @FOREGROUND@;
@define-color unfocused_insensitive_color @MUTED@;
@define-color borders @BORDER@;
@define-color unfocused_borders @BORDER@;
@define-color warning_color @GOLD@;
@define-color error_color @RED@;
@define-color success_color @GREEN@;
@define-color destructive_color @RED@;
@define-color content_view_bg @BACKGROUND@;
@define-color text_view_bg @ROFI_SURFACE_COLOR@;

window,
window.background,
.background {
    color: @FOREGROUND@;
    background-color: @BACKGROUND@;
}

menubar,
toolbar,
headerbar,
.titlebar,
notebook > header {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_COLOR@;
    background-image: none;
    border-color: @BORDER@;
    box-shadow: none;
}

menubar > menuitem:hover,
menubar > menuitem:focus,
toolbar button:hover,
headerbar button:hover,
notebook > header > tabs > tab:hover {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_HOVER_COLOR@;
    background-image: none;
}

button,
entry,
combobox button,
spinbutton {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_COLOR@;
    background-image: none;
    border-color: @BORDER@;
    box-shadow: none;
}

button:hover,
button:focus,
entry:focus,
combobox button:hover {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_HOVER_COLOR@;
    background-image: none;
    border-color: @ACCENT@;
}

button:checked,
button:active,
switch:checked,
notebook > header > tabs > tab:checked {
    color: @SELECTION_TEXT@;
    background-color: @ACCENT@;
    background-image: none;
    border-color: @ACCENT@;
}

.view,
iconview,
treeview.view,
textview text {
    color: @FOREGROUND@;
    background-color: @BACKGROUND@;
}

.view:selected,
.view:selected:focus,
iconview:selected,
treeview.view:selected,
row:selected {
    color: @SELECTION_TEXT@;
    background-color: @ACCENT@;
}

.sidebar,
placessidebar,
placessidebar list,
placessidebar row,
treeview.view.sidebar {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_COLOR@;
}

placessidebar row:hover,
treeview.view.sidebar:hover {
    background-color: @ROFI_SURFACE_HOVER_COLOR@;
}

menu,
.menu,
popover,
popover.background {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_COLOR@;
    border-color: @BORDER@;
}

menuitem:hover,
menuitem:focus,
popover row:hover {
    color: @SELECTION_TEXT@;
    background-color: @ACCENT@;
}

scrollbar trough {
    background-color: @BACKGROUND@;
}

scrollbar slider {
    background-color: @BORDER@;
    border-color: @BACKGROUND@;
}

scrollbar slider:hover,
scrollbar slider:active {
    background-color: @ACCENT@;
}

separator {
    color: @BORDER@;
    background-color: @BORDER@;
}

tooltip,
tooltip.background {
    color: @FOREGROUND@;
    background-color: @ROFI_SURFACE_COLOR@;
    border-color: @BORDER@;
}

.rubberband,
rubberband {
    background-color: alpha(@ACCENT@, 0.25);
    border-color: @ACCENT@;
}

progressbar progress,
levelbar block.filled {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
}

*:disabled {
    color: @MUTED@;
}
