* {
    background: @ROFI_BACKGROUND@;
    surface: @ROFI_SURFACE@;
    surface-hover: @ROFI_SURFACE_HOVER@;
    foreground: @FOREGROUND@;
    muted: @MUTED@;
    accent: @ACCENT@;
    panel-border: @BORDER@;
    window-radius: @ROFI_WINDOW_RADIUS@px;
    control-radius: @ROFI_CONTROL_RADIUS@px;
    selection-text: @SELECTION_TEXT@;
    urgent-text: @URGENT_TEXT@;
    selection: @ROFI_SELECTION@;
    red: @RED@;
    green: @GREEN@;
}
